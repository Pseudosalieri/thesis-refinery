# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{md,qmd,yml,yaml,json,toml}]
indent_size = 2

[*.{md,qmd}]
# Markdown tables and Chinese prose read better without hard wrapping rules,
# but we still want trailing whitespace trimmed (it means <br> in Markdown).
trim_trailing_whitespace = true

[Makefile]
indent_style = tab

[*.{docx,png,jpg,jpeg,pdf}]
insert_final_newline = false
